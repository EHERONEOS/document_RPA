# export UV_CACHE_DIR="$(pwd)/.uv_cache"
APP_ENV=test
# 队列由中心控制平台分配给设备，Agent 不再读取 RPA_QUEUES 启动监听。
# RabbitMQ 默认从 Nacos 的 rabbitmq.yml 按 APP_ENV 读取。
RABBITMQ_CONFIG_SOURCE=nacos
# 启动时默认从 Nacos 加载通用环境变量；本地无 Nacos 时可设置为 false。
NACOS_ENABLED=true
CONTROL_DRAIN_TIMEOUT_SECONDS=1800
QUEUE_CONTROL_MYSQL_URL=mysql://queue_control:queue_control@127.0.0.1:3306/queue_control
QUEUE_CONTROL_REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_CONTROL_HOST=127.0.0.1
QUEUE_CONTROL_PORT=8766
# 请先在维护页面新增设备，再将页面展示的一次性注册令牌填到目标机器。
QUEUE_CONTROL_DEVICE_ID=
QUEUE_CONTROL_DEVICE_TOKEN=
# 浏览器调试端口池。临时浏览器关闭后会释放端口；请避开系统已使用端口。
BROWSER_PORT_START=10000
BROWSER_PORT_END=48000
DOWNLOAD_DIR=runtime/downloads
BROWSER_USER_DATA_DIR=runtime/browser_profiles
# 每个队列消费并发；同一 websiteInfo.id + 船司跨队列仍最多运行 3 条。
QUEUE_CONCURRENT_NUM=3
QUEUE_QPS=3
ACCOUNT_MAX_CONCURRENT=3
# 同一账号在此时间内没有新消息时，关闭额外临时浏览器，仅保留主浏览器。
ACCOUNT_IDLE_SECONDS=60
ENABLE_REMOTE_KILL_TASK=false
