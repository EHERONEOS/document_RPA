# 运行环境：local / test / prod
APP_ENV=test
# 是否从 Nacos 加载通用配置
NACOS_ENABLED=true

# 队列来源：server=平台下发；local=用 RPA_QUEUES
QUEUE_ASSIGNMENT_SOURCE=server
# 本地队列，逗号分隔；local 必填，server 未下发/失联时兜底
RPA_QUEUES=FHT_MSCGW_SI,QTCT_ZIM_SI,QTCT_ZIM_VGM

# 设备 ID / 令牌（server 模式必填；在平台页面注册设备后获得一次性令牌）
QUEUE_CONTROL_DEVICE_ID=DEVICE_1
QUEUE_CONTROL_DEVICE_TOKEN=<在平台注册设备后生成的一次性令牌>
# 控制面 Redis
# 队列命令总线 Redis：中央机本机用 127.0.0.1；Agent 目标机器填中央机局域网 IP（如 redis://192.168.10.46:6379/0）
QUEUE_CONTROL_REDIS_URL=redis://:RpaRedis2026@192.168.10.93:6379/0
# 排空超时（秒）
CONTROL_DRAIN_TIMEOUT_SECONDS=1800

# 浏览器调试端口池
BROWSER_PORT_START=10000
BROWSER_PORT_END=48000
# 下载目录 / 浏览器 profile 目录
DOWNLOAD_DIR=runtime/downloads
BROWSER_USER_DATA_DIR=runtime/browser_profiles

# 单队列并发数 / 每秒处理上限
QUEUE_CONCURRENT_NUM=3
QUEUE_QPS=3
# 同账号浏览器槽位上限
ACCOUNT_MAX_CONCURRENT=3
# 账号空闲回收临时浏览器（秒）
ACCOUNT_IDLE_SECONDS=60

# 每天关闭空闲 RPA 浏览器，避免长驻进程异常
BROWSER_CLEANUP_ENABLED=true
BROWSER_CLEANUP_TIME=20:30
# 到点后等待忙碌任务结束的最长时间（秒）
BROWSER_CLEANUP_WAIT_BUSY_SECONDS=1800


# ---- RPA 执行日志远程上报（合并后的后台 8766；consumer/base_task 已接入，仅开关配置）----
# 日志上报开关：false/未设置时任何模式（队列监听、本地调试）都不上报
RPA_LOG_SERVICE_ENABLED=true
RPA_LOG_SERVICE_URL=http://192.168.10.93:8766
RPA_LOG_SERVICE_TOKEN=test-dev
# RPA_LOG_DEVICE_NAME 不配则依次取 QUEUE_CONTROL_DEVICE_ID（当前 DEVICE_1）→ 主机名

# ---- 录屏质量（单参数，app/core/page/recorder.py）----
# low / medium（默认）/ high，一档同时决定 JPEG 质量 / CRF / 宽度 / 帧率 / 码率顶：
#   low    JPEG 60 / CRF 30 + 码率硬顶 240k / 960 宽 / 5fps
#          → 体积硬上限 ≈1.8MB/分钟，5 分钟 <9MB（要求 5 分钟 ≤10MB 用这档）
#   medium JPEG 80 / CRF 23 / 1280 宽 / 5fps  ≈ 3-5MB/分钟
#   high   JPEG 90 / CRF 20 / 1920 宽 / 10fps ≈ 8-15MB/分钟
CAPTURE_QUALITY=medium
# 体积数学：low 档 VBV 码率顶 240kbps × 300 秒 ≈ 8.8MB + 容器开销 < 9MB < 10MB
# （OSS 上限）；超过 5 分钟的任务每分钟约 +1.8MB，10 分钟 ≈ 18MB 会超限

# ---- 以下细粒度参数通常无需配置，设置后仅覆盖档位中的对应项 ----
# CAPTURE_FPS=5                  # 帧率
# CAPTURE_VIDEO_SCALE=1280:-2    # 输出宽度（同时决定浏览器端 maxWidth）
# CAPTURE_VIDEO_CRF=23           # H264 CRF，越小越清晰、体积越大
# CAPTURE_JPEG_QUALITY=80        # CDP screencast JPEG 质量
# CAPTURE_VIDEO_PRESET=veryfast  # x264 预设；medium/slow 同画质体积更小
# CAPTURE_BACKEND=auto           # 采集后端：auto/cdp/ffmpeg/wgc/cli
# CAPTURE_BITRATE_KBPS=          # 无 libx264 时的定码率（kbps），不设按 CRF 推导
