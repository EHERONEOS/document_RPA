# 运行环境：local / test / prod
APP_ENV=test
# 是否从 Nacos 加载通用配置
NACOS_ENABLED=true

# 队列来源：server=平台下发；local=用 RPA_QUEUES
QUEUE_ASSIGNMENT_SOURCE=server
# 本地队列，逗号分隔；local 必填，server 未下发/失联时兜底
RPA_QUEUES=FHT_MSCGW_SI,QTCT_ZIM_SI,QTCT_ZIM_VGM

# 设备 ID / 令牌（server 模式必填）
QUEUE_CONTROL_DEVICE_ID=DEVICE_1
QUEUE_CONTROL_DEVICE_TOKEN=8Qtew8ozSF-L5T5r6Z8yDcsOQJYSaZX_-ZyrMEorpGY
# 控制面 Redis
# 队列命令总线 Redis：中央机本机用 127.0.0.1；Agent 目标机器填中央机局域网 IP（如 redis://192.168.10.46:6379/0）
QUEUE_CONTROL_REDIS_URL=redis://127.0.0.1:6379/0
# 排空超时（秒）
CONTROL_DRAIN_TIMEOUT_SECONDS=1800

# 浏览器调试端口池
BROWSER_PORT_START=10000
BROWSER_PORT_END=48000
# 下载目录 / 浏览器 profile 目录
DOWNLOAD_DIR=runtime/downloads
BROWSER_USER_DATA_DIR=runtime/browser_profiles

# 单队列并发数 / 每秒处理上限
QUEUE_CONCURRENT_NUM=3
QUEUE_QPS=3
# 同账号浏览器槽位上限
ACCOUNT_MAX_CONCURRENT=3
# 账号空闲回收临时浏览器（秒）
ACCOUNT_IDLE_SECONDS=60

# 每天关闭空闲 RPA 浏览器，避免长驻进程异常
BROWSER_CLEANUP_ENABLED=true
BROWSER_CLEANUP_TIME=20:30
# 到点后等待忙碌任务结束的最长时间（秒）
BROWSER_CLEANUP_WAIT_BUSY_SECONDS=1800

# 以下仅控制平台使用，Agent 不读
# 统一库连接：仅中央机（后台服务）使用；Agent 目标机器不需要配置（代码不直连 MySQL）
QUEUE_CONTROL_MYSQL_URL=mysql://queue_control:queue_control@127.0.0.1:3306/rpa_platform
QUEUE_CONTROL_HOST=0.0.0.0
QUEUE_CONTROL_PORT=8766

# ---- 录屏（主后端 CDP screencast：不依赖显卡驱动/系统采集层，Win10/Win11/macOS 兼容）----
# auto=浏览器 CDP screencast 优先，失败降级 FFmpeg OS 采集（Win=gdigrab/mac=avfoundation）
# cdp/browser=只用浏览器 screencast；gdi/ffmpeg=只用 FFmpeg OS 采集
# wgc=原生 Windows Graphics Capture（windows-capture 包，仅 Win10 1903+）：按窗口采集，
#     录到整个浏览器含地址栏，遮挡/多浏览器重叠不影响；需 pip install windows-capture
# cli/capturesdk/wgcsdk=旧 CaptureSDK（WGC 的 C# CLI 版，保留兼容）
#CAPTURE_BACKEND=auto
# 画质：CRF 越大文件越小（18≈近无损，28≈推荐，32≈更小）
#CAPTURE_VIDEO_CRF=28
# 缩放：1280:-2 表示宽最大 1280 且保持比例；留空则保持原尺寸
#CAPTURE_VIDEO_SCALE=1280:-2
#CAPTURE_FPS=5
# Windows 是否裁剪到浏览器窗口；false 则录整个桌面
#CAPTURE_CROP_WINDOW=true
# WGC 专属：是否录鼠标光标（默认 true）
#CAPTURE_WGC_CURSOR=true
# WGC 专属：是否画采集边框（默认系统决定=Win10 黄框；设 false 尝试去边框，仅 Win11 生效）
#CAPTURE_WGC_DRAW_BORDER=
#FFMPEG_PATH=

# ---- RPA 执行日志远程上报（合并后的后台 8766；consumer/base_task 已接入，仅开关配置）----
RPA_LOG_SERVICE_ENABLED=true
RPA_LOG_SERVICE_URL=http://127.0.0.1:8766
RPA_LOG_SERVICE_TOKEN=local-dev
# RPA_LOG_DEVICE_NAME 不配则依次取 QUEUE_CONTROL_DEVICE_ID（当前 DEVICE_1）→ 主机名
